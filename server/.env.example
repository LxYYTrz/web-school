# MQTT(EMQX;本地开发 1883 明文,生产改 8883/TLS)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# PostgreSQL(TimescaleDB)
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/linetwin

# Redis
REDIS_URL=redis://localhost:6379

# HTTP / WebSocket 服务端口
PORT=3000

# 跨域(生产收敛为前端域名;多值逗号分隔)
CORS_ORIGIN=http://localhost:5173

# session cookie 签名密钥(32+ 字节随机串;生产必须改)
SESSION_SECRET=dev-only-session-secret-change-me-in-production-xxxxxx

# 首次启动自动建 admin 时的初始密码(部署后必须立即改)
ADMIN_PASSWORD=admin123

# 数据契约主题前缀(见 docs/contract/README.md)
TOPIC_PREFIX=tl/v1

# ---------------------------------------------------------------------------
# AI 助手(hermes agent)。留空 AI_API_KEY 即视为未启用,相关端点返回 503。
# AI_API_KEY 填的是 hermes 侧的 API_SERVER_KEY(见 hermes 的 .env),两边必须一致。
# AI_BASE_URL 只绑 127.0.0.1:8642 —— hermes 不对外暴露,浏览器也永远拿不到这个 key。
# ---------------------------------------------------------------------------
AI_BASE_URL=http://127.0.0.1:8642/v1
AI_API_KEY=
AI_MODEL=hermes-agent
AI_TIMEOUT_MS=120000
# hermes session 前缀:同一用户名复用同一 session,保住 hermes 的 memory/skills
AI_SESSION_PREFIX=lt

# ---------------------------------------------------------------------------
# 视觉图片链路(契约 §4)。视觉机 POST 到 /api/vision/images,Header 带 X-Vision-Token。
#
# ⚠️ VISION_TOKEN 必须改。留空 = 上传接口 503 禁用(这是刻意的 fail closed:
#    云端 nginx 把 /api/ 全量反代到公网 8081,没配密钥等于对全世界开放上传)。
#    视觉机那侧配同一个值。
# ---------------------------------------------------------------------------
VISION_TOKEN=
# 图片落盘根目录(按天分目录:{根}/{YYYY-MM-DD}/{sn}.jpg)
VISION_STORAGE_DIR=D:/line-twin/data/vision
# 原图保留小时数,到期由 VisionCleanupService 删文件 + 删表行。
# 按节拍 8.5s 一件、均值 2.5MB 估算 ≈ 25GB/天。
VISION_RETENTION_HOURS=24
VISION_THUMB_MAX_EDGE=640
VISION_THUMB_QUALITY=80
# 视觉机不上报时的兜底值(需与 production_lines.code / devices.code 对得上)
VISION_DEFAULT_LINE_ID=line-01
VISION_DEFAULT_CAMERA_ID=cam-01
# 纯内存保护硬顶(不是业务限制)。这台机同时跑 PLC 轮询,一次 OOM 会连带采集器一起死。
VISION_MAX_UPLOAD_BYTES=104857600
VISION_CLEANUP_INTERVAL_MS=21600000
