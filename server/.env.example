# MQTT(EMQX;本地开发 1883 明文,生产改 8883/TLS)
# MQTT(EMQX;本地开发 1883 明文,生产改 8883/TLS)
# 格式：mqtt://[用户名:密码@]主机:端口
# 工控机本机：mqtt://localhost:1883
# 云端：       mqtt://<云服务器IP>:8883
MQTT_URL=mqtt://localhost:1883
# MQTT 账号（生产必须配，配合 EMQX 关闭匿名登录）
MQTT_USERNAME=
# MQTT 密码
MQTT_PASSWORD=

# PostgreSQL(TimescaleDB)
# 格式：postgres://用户:密码@主机:端口/库名
# ★ 最终部署形态下这里的 localhost:5432 是 SSH 正向隧道入口，
#   隧道另一端才是云服务器上的真实数据库。
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/linetwin

# Redis
REDIS_URL=redis://localhost:6379

# HTTP / WebSocket 服务端口
# ★ REST 与 WebSocket 共用这一个端口
PORT=3000

# 跨域(生产收敛为前端域名;多值逗号分隔)
CORS_ORIGIN=http://localhost:5173

# session cookie 签名密钥(32+ 字节随机串;生产必须改)
SESSION_SECRET=dev-only-session-secret-change-me-in-production-xxxxxx

# 首次启动自动建 admin 时的初始密码(部署后必须立即改)
ADMIN_PASSWORD=admin123

# 数据契约主题前缀(见 docs/contract/README.md)
# 所有 MQTT 主题：tl/v1/{lineId}/...
# 契约大版本变更时升级为 v2 并灰度并行
TOPIC_PREFIX=tl/v1

# ---------------------------------------------------------------------------
# AI 助手(hermes agent)。留空 AI_API_KEY 即视为未启用,相关端点返回 503。
# AI_API_KEY 填的是 hermes 侧的 API_SERVER_KEY(见 hermes 的 .env),两边必须一致。
# AI_BASE_URL 只绑 127.0.0.1:8642 —— hermes 不对外暴露,浏览器也永远拿不到这个 key。
# ---------------------------------------------------------------------------
AI_BASE_URL=http://127.0.0.1:8642/v1
AI_API_KEY=
AI_MODEL=hermes-agent
AI_TIMEOUT_MS=120000
# hermes session 前缀:同一用户名复用同一 session,保住 hermes 的 memory/skills
AI_SESSION_PREFIX=lt
