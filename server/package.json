{
  "name": "line-twin-server",
  "version": "0.1.0",
  "private": true,
  "description": "产线数字孪生平台 - 云端后端(NestJS 最小链路:MQTT → TimescaleDB/Redis → WebSocket)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "mqtt": "^5.10.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
